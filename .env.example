# BEEF — environment template
# Copy to `.env` (never commit real values; the repo is public).
# Backend env vars are read by the Bun backend at runtime. The Flutter app does
# NOT read this file — it takes BEEF_API_BASE_URL as a --dart-define at build.

# Postgres connection string (Neon or any Postgres with postgis + citext).
# Required for ANY database query including db/migrate.ts.
DATABASE_URL=

# HMAC-SHA256 signing secret for access (15m) and refresh (30d) JWTs.
# Required; must be at least 32 characters. Use a long random string:
#   openssl rand -base64 48
JWT_SECRET=

# Shared secret for the internal moderation admin routes
# (GET /api/moderation/queue, POST /api/moderation/review), sent by the caller
# as the `X-Moderation-Key` header. The persistent server requires at least 32
# characters at startup. Generate with e.g.
#   openssl rand -base64 24
MODERATION_ADMIN_KEY=

# Google Cloud Vision API key for AI image screening (SafeSearch adult/racy/
# violence). Optional: when unset, image moderation returns "pending_human" —
# uploads stay blurred and queue for human review instead of being rejected.
# Only image bytes + an opaque photo id are ever sent to the API.
IMAGE_MODERATION_API_KEY=

# Path to a JSONL waitlist export for `bun run scripts/import-waitlist.ts`.
# Optional; the script defaults to ./waitlist.jsonl if unset.
WAITLIST_FILE=

# --- Flutter app (NOT an env-file var) --------------------------------------
# The Flutter client reads its API base URL at COMPILE time via --dart-define:
#   flutter build ... --dart-define=BEEF_API_BASE_URL=https://your-host
# Default (no define) is compiled inside app/lib/config/api_config.dart.
BEEF_API_BASE_URL=

# Persistent Bun server: explicit bind, readiness and shutdown settings.
# Loopback is the safe default; containers can explicitly bind 0.0.0.0.
BEEF_HOST=127.0.0.1
BEEF_PORT=3000
BEEF_READINESS_TIMEOUT_MS=2000
BEEF_SHUTDOWN_TIMEOUT_MS=10000

# Database transport: existing Neon HTTP default, or Bun native PostgreSQL.
BEEF_DATABASE_DRIVER=neon
# Native defaults to verified TLS. Use sslmode=disable ONLY for separately approved
# isolated/private transport; never an automatic fallback from a TLS failure.

# Fail-closed default. Empty allowlist intentionally prevents service startup.
# Comma-separated exact approved synthetic account emails, no domain wildcards.
BEEF_ACCESS_MODE=closed_test
BEEF_CLOSED_TEST_EMAILS=
